{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/app.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "buildCommand": "pip install -r backend/requirements.txt && python backend/manage.py migrate --noinput && python backend/manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/backend/app.py"
    },
    {
      "src": "^/admin(?:/(.*))?$",
      "dest": "/backend/app.py"
    },
    {
      "src": "^/static(?:/(.*))?$",
      "dest": "/backend/app.py"
    },
    {
      "src": "^/media/(.*)$",
      "dest": "/backend/app.py"
    },
    {
      "src": "^/published-media/(.*)$",
      "dest": "/published-media/$1"
    },
    {
      "src": "^/published-content\\.json$",
      "dest": "/published-content.json"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}